; Configuration file for RepRapFirmware on Duet 3 Main Board 6HC
; executed by the firmware on start-up
;
; generated by RepRapFirmware Configuration Tool v3.6.16 on Sat Oct 03 2026 07:14:44 GMT+0100 (British Summer Time)

; General
G90 ; absolute coordinates
M83 ; relative extruder moves
M550 P"Cascade" ; set hostname

; Smart Drivers
M569 P0.0 S1 D2 ; driver 0.0 goes forwards (X axis)
M569 P0.1 S1 D2 ; driver 0.1 goes forwards (Y axis)
M569 P0.2 S1 D2 ; driver 0.2 goes forwards (Z axis)

; Motor Idle Current Reduction
M906 I30 T30 ; set motor current idle factor and idle timeout

; Axes
M584 X0.0 Y0.1 Z0.2 ; set axis mapping
M350 X16 Y16 Z16 I1 ; configure microstepping with interpolation
M906 X2500 Y2500 Z2500 ; set axis driver currents
M92 X800 Y800 Z8000 ; configure steps per mm
M208 X0:300 Y0:220 Z0:120 ; set minimum and maximum axis limits
M566 X900 Y900 Z12 ; set maximum instantaneous speed changes (mm/min)
M203 X6000 Y6000 Z180 ; set maximum speeds (mm/min)
M201 X500 Y500 Z20 ; set accelerations (mm/s^2)

; Kinematics
M669 K0 ; configure Cartesian kinematics

; Probes
M558 K0 P8 C"io3.in" H5 F120 T6000 ; configure unfiltered digital probe via slot #0
G31 P500 X0 Y0 Z0.7 ; set Z probe trigger value, offset and trigger height

; Endstops
M574 X1 P"io4.in" S1 ; configure X axis endstop
M574 Y1 P"io5.in" S1 ; configure Y axis endstop
M574 Z1 P"io6.in" S1 ; configure Z axis endstop

; CNC pendant
;M575 P2 S0 B57600 ; enable pendant P2=IO_0

; RS485 converter
M575 P2 B9600 S7; P3=IO_1, B9600=baud, S7=device mode
;M575 P2 B9600 S7 C"io0.out"; P3=IO_1, B9600=baud, S7=device mode, C"io1.out"=io1.out controls Tx/Rx switching

; Create Spindle 0 using VFD output pin
; L0:24000 = RPM range, Q1000 = PWM frequency (not used by Modbus but required)
M950 R0 C"vfd" L0:24000 Q1000

; Global variables for daemon.g VFD state tracking
global vfdState = "stopped"
global vfdFreq = 0
global vfdActualRPM = 0

; Tools
;M563 P0 S"Spindle" F0 R0 ; create tool #0

; Miscellaneous
M453 ; select CNC mode
T0 ; select first tool
